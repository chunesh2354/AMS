# Caddy gets and renews the HTTPS certificate on its own once DNS points at this server.
# install-server-files.sh replaces {$AMS_DOMAIN} when it installs this file.
# /opt/ams/web/dist-live is root-owned; ams-deploy swaps a new build in with a rename (the previous one stays
# as dist-live.prev), so it is never empty or half-written while Caddy serves it.
{$AMS_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		root * /opt/ams/web/dist-live
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
