[Unit]
Description=AMS API
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
User=ams
Group=ams
# The release directory is owned by root (copied there by ams-deploy): the service, running as ams, cannot change
# its own code. ProtectSystem=strict makes it read-only as well; the API writes nothing to disk (tsx caches in /tmp).
WorkingDirectory=/opt/ams/app/apps/api
EnvironmentFile=/etc/ams/env
ExecStart=/usr/bin/node --import tsx src/main.ts
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
MemoryMax=900M

[Install]
WantedBy=multi-user.target
